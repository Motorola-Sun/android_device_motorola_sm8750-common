# TikTap
allow hal_vibrator_default proc_tiktap_buf:file { rw_file_perms map };
# TIKTAP_GET_F0, TIKTAP_SETTING_GAIN, TIKTAP_RTP_MODE, TIKTAP_STOP_MODE
allowxperm hal_vibrator_default proc_tiktap_buf:file ioctl { 0xff01 0xff04 0xff09 0xff0b };

# LED class vibrator nodes
allow hal_vibrator_default sysfs_leds:dir r_dir_perms;
allow hal_vibrator_default sysfs_leds:file rw_file_perms;
